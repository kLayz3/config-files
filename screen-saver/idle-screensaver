#!/usr/bin/env bash

VIDEO="$HOME/Videos/screensaver/hatsune-miku-s-room-moewalls-com.mp4"
PIDFILE="/tmp/idle-screensaver-mpv.pid"

# Do not start twice
if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    exit 0
fi

:> "$PIDFILE"

# Start one mpv per exposed monitor
mapfile -t MONITORS < <(hyprctl monitors -j | jq -r '.[].name')

for mon in "${MONITORS[@]}"; do
  echo "mon: $mon"
  mpv \
    --fs \
    --fs-screen-name="$mon" \
    --loop \
    --no-audio \
    --ontop \
    --title="idle-screensaver-$mon" \
    "$VIDEO" &
  
  echo $! >> "$PIDFILE"
done
