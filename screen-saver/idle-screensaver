#!/usr/bin/env bash

VIDEO="$HOME/Videos/screensaver/hatsune-miku-s-room-moewalls-com.mp4"
MPV_PIDFILE="/tmp/idle-screensaver-mpv.pid"
LOCK_PIDFILE="/tmp/idle-screensaver-lock.pid"

LOCK_AFTER=240

# Do not start twice
if [[ -f "$MPV_PIDFILE" ]] && kill -0 "$(cat "$MPV_PIDFILE")" 2>/dev/null; then
    exit 0
fi
if [[ -f "$LOCK_PIDFILE" ]] && xargs -r kill -0 < "$(cat "$LOCK_PIDFILE")" 2>/dev/null; then
    exit 0
fi

:> "$MPV_PIDFILE"

# Start one mpv per exposed monitor
mapfile -t MONITORS < <(hyprctl monitors -j | jq -r '.[].name')

for mon in "${MONITORS[@]}"; do
  mpv \
    --fs \
    --fs-screen-name="$mon" \
    --loop \
    --no-audio \
    --title="idle-screensaver-$mon" \
    "$VIDEO" &
  
  echo $! >> "$MPV_PIDFILE"
done

# Delay lock sequence
(
  sleep "$LOCK_AFTER"
  
  # Kill the screensaver first
  ~/.local/bin/idle-screensaver-stop-video

  omarchy-system-lock
) &

echo $! > "$LOCK_PIDFILE"
